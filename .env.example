# PostgreSQL dedicado ao Overcore. Não use credenciais de projetos atendidos.
OVERCORE_DATABASE_URL=postgresql://overcore_app:troque-esta-senha@127.0.0.1:5432/overcore

# API local do Overcore. Zero pede ao Windows uma porta livre.
OVERCORE_HOST=127.0.0.1
OVERCORE_PORT=0
OVERCORE_LOCAL_TOKEN=gere-um-segredo-longo

# Endpoint neutro que implementará a porta Authority Provider do Omni.
OVERCORE_AUTHORITY_PROVIDER_URL=http://127.0.0.1:47832/v1/authority/evaluate
OVERCORE_AUTHORITY_PROVIDER_TOKEN=gere-outro-segredo-longo

# Claude Agent SDK: autenticação exclusivamente pelo login local já feito no Claude.
# O Overcore não lê API key e rejeita uma execução cujo init não declare OAuth.
# Não existe variável ANTHROPIC_API_KEY neste arquivo.
