{
  "agente": "overcore",
  "versao": "0.1.0",
  "banco": "overcore.db",
  "migracoes": "migrations-sqlite/",
  "requer": {
    "node": ">=24",
    "agentes": [
      "omni>=0.26"
    ]
  },
  "executor": {
    "comando": "node dist/executor/overcore-executor.js",
    "modos": [
      "instalar",
      "importar",
      "exportar",
      "atualizar",
      "verificar",
      "servir"
    ]
  },
  "interface": {
    "modulo": "interface/index.html",
    "preload": "interface/overcore-preload.js",
    "painel": "Overcore",
    "api": "http://127.0.0.1:{porta}/v1",
    "rotas": [
      { "metodo": "GET", "padrao": "^/v1/saude$", "escopo": "qualquer" },
      { "metodo": "GET", "padrao": "^/v1/capabilities$", "escopo": "qualquer" },
      { "metodo": "GET", "padrao": "^/v1/validation-evidence$", "escopo": "qualquer" },
      { "metodo": "GET", "padrao": "^/v1/tasks/[A-Za-z0-9._:-]+$", "escopo": "qualquer" }
    ]
  },
  "tarefas": [],
  "credenciais": []
}
