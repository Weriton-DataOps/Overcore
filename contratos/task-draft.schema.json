{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:overcore:contracts:task-draft:v1",
  "title": "OverCore TaskDraft v1",
  "description": "Entrada preliminar, possivelmente incompleta, enviada ao Preflight do Task Manager.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "draftId",
    "revision",
    "idempotencyKey",
    "executionIdempotencyKey",
    "createdAt",
    "client",
    "objective",
    "context",
    "knownConstraints",
    "knownAcceptanceCriteria",
    "discoveryAuthority",
    "availableExecutionAuthority",
    "executionBudget",
    "decisionAnswers",
    "preflightBudget"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0"
    },
    "draftId": {
      "$ref": "#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "executionIdempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "correlationId": {
      "$ref": "#/$defs/identifier"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": ["assistant", "cli", "api", "automation", "service", "other"]
        }
      }
    },
    "objective": {
      "type": "string",
      "minLength": 3,
      "maxLength": 4000
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["references", "assumptions"],
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 8000
        },
        "references": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/contextReference"
          }
        },
        "assumptions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/assumption"
          }
        }
      }
    },
    "knownConstraints": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "knownAcceptanceCriteria": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/knownCriterion"
      }
    },
    "discoveryAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "grants"],
      "properties": {
        "mode": {
          "const": "inspect-only"
        },
        "grants": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/discoveryGrant"
          }
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "availableExecutionAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "grants", "expansionBoundaries"],
      "properties": {
        "mode": {
          "const": "proceed-within-scope"
        },
        "grants": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/executionGrant"
          }
        },
        "expansionBoundaries": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "destructive",
              "irreversible",
              "financial",
              "privilege-expansion",
              "external-publication",
              "secret-access"
            ]
          }
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "executionBudget": {
      "$ref": "#/$defs/executionBudget"
    },
    "decisionAnswers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/decisionAnswer"
      }
    },
    "preflightBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxDurationMs", "maxInspectionOperations"],
      "properties": {
        "maxDurationMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 900000
        },
        "maxInspectionOperations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "executionHints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "priority": {
          "enum": ["low", "normal", "high", "urgent"]
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        },
        "expectedOutputKind": {
          "enum": ["text", "json", "report", "file", "repository-change", "artifact-set", "no-artifact"]
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "const": "sha256-jcs-v1"
        },
        "value": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "operationToken": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9]*)+$",
      "maxLength": 100
    },
    "contextReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refId", "uri", "kind", "sensitivity"],
      "properties": {
        "refId": {
          "$ref": "#/$defs/identifier"
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2000
        },
        "kind": {
          "enum": ["repository", "workspace", "file", "document", "artifact", "url", "service", "other"]
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sensitivity": {
          "enum": ["public", "internal", "restricted"]
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "impactIfFalse"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "statement": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        },
        "impactIfFalse": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": ["technical", "quality", "temporal", "policy", "compatibility", "business", "other"]
        },
        "description": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        },
        "sourceRef": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "knownCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        },
        "verificationHint": {
          "enum": ["command", "test", "inspection", "schema", "external", "human"]
        }
      }
    },
    "discoveryOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "effect"],
      "properties": {
        "name": {
          "$ref": "#/$defs/operationToken"
        },
        "effect": {
          "const": "read"
        }
      }
    },
    "discoveryGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceRef", "operations"],
      "properties": {
        "resourceRef": {
          "$ref": "#/$defs/identifier"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/discoveryOperation"
          }
        }
      }
    },
    "executionGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceRef", "operations"],
      "properties": {
        "resourceRef": {
          "$ref": "#/$defs/identifier"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/operationToken"
          }
        }
      }
    },
    "executionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "limits"],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceId"],
          "properties": {
            "kind": {
              "enum": ["client-explicit", "policy-default", "decision-answer"]
            },
            "sourceId": {
              "$ref": "#/$defs/identifier"
            },
            "sourceVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "sourceDigest": {
              "$ref": "#/$defs/sha256"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "policy-default"
                  }
                },
                "required": ["kind"]
              },
              "then": {
                "required": ["sourceVersion", "sourceDigest"]
              }
            }
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxDurationMs", "maxAttempts", "maxParallelism"],
          "properties": {
            "maxDurationMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 604800000
            },
            "maxAttempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "maxParallelism": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "maxTokens": {
              "type": "integer",
              "minimum": 1
            },
            "maxCostUsd": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "decisionAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answerId",
        "decisionId",
        "sourceReport",
        "selectedOptionId",
        "answeredAt",
        "answeredBy"
      ],
      "properties": {
        "answerId": {
          "$ref": "#/$defs/identifier"
        },
        "decisionId": {
          "$ref": "#/$defs/identifier"
        },
        "sourceReport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reportId",
            "draftRevision",
            "draftFingerprint",
            "reportFingerprint"
          ],
          "properties": {
            "reportId": {
              "$ref": "#/$defs/identifier"
            },
            "draftRevision": {
              "type": "integer",
              "minimum": 1
            },
            "draftFingerprint": {
              "$ref": "#/$defs/fingerprint"
            },
            "reportFingerprint": {
              "$ref": "#/$defs/fingerprint"
            }
          }
        },
        "selectedOptionId": {
          "$ref": "#/$defs/identifier"
        },
        "answeredAt": {
          "type": "string",
          "format": "date-time"
        },
        "answeredBy": {
          "$ref": "#/$defs/identifier"
        }
      }
    }
  }
}
