{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:overcore:contracts:authorization-request:v1",
  "title": "OverCore AuthorizationRequest v1",
  "description": "Pedido exato e imutável para um provedor de autoridade avaliar uma revisão do Execution Plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "authorizationRequestId",
    "createdAt",
    "requester",
    "authorityProvider",
    "requestBinding",
    "planBinding",
    "authorityCeiling",
    "actions",
    "riskSummary",
    "authorizationRequestFingerprint"
  ],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "authorizationRequestId": { "$ref": "#/$defs/identifier" },
    "createdAt": { "$ref": "#/$defs/dateTime" },
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "const": "execution-environment" }
      }
    },
    "authorityProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["assistant", "service"] }
      }
    },
    "requestBinding": { "$ref": "#/$defs/requestBinding" },
    "planBinding": { "$ref": "#/$defs/planBinding" },
    "authorityCeiling": { "$ref": "#/$defs/authorityCeiling" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/actionAuthorizationRequest" }
    },
    "riskSummary": { "$ref": "#/$defs/riskSummary" },
    "authorizationRequestFingerprint": { "$ref": "#/$defs/fingerprint" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "dateTime": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256-jcs-v1" },
        "value": { "$ref": "#/$defs/sha256" }
      }
    },
    "operationToken": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9]*)+$",
      "maxLength": 100
    },
    "requestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "requestFingerprint", "clientId"],
      "properties": {
        "requestId": { "$ref": "#/$defs/identifier" },
        "requestFingerprint": { "$ref": "#/$defs/fingerprint" },
        "clientId": { "$ref": "#/$defs/identifier" }
      }
    },
    "planBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planId", "planRevision", "planFingerprint", "strategyFingerprint"],
      "properties": {
        "planId": { "$ref": "#/$defs/identifier" },
        "planRevision": { "type": "integer", "minimum": 1, "maximum": 20 },
        "planFingerprint": { "$ref": "#/$defs/fingerprint" },
        "strategyFingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "authorityGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceRef", "operations"],
      "properties": {
        "resourceRef": { "$ref": "#/$defs/identifier" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/operationToken" }
        }
      }
    },
    "authorityCeiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "grants", "expansionBoundaries"],
      "properties": {
        "mode": { "const": "proceed-within-scope" },
        "grants": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/authorityGrant" }
        },
        "expansionBoundaries": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "destructive",
              "irreversible",
              "financial",
              "privilege-expansion",
              "external-publication",
              "secret-access"
            ]
          }
        },
        "expiresAt": { "$ref": "#/$defs/dateTime" }
      }
    },
    "actionAuthorizationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "stepRef",
        "position",
        "scope",
        "operation",
        "effectMode",
        "effectClass",
        "riskLevel",
        "requestedControls"
      ],
      "properties": {
        "actionId": { "$ref": "#/$defs/identifier" },
        "stepRef": { "$ref": "#/$defs/identifier" },
        "position": { "type": "integer", "minimum": 1, "maximum": 256 },
        "scope": { "enum": ["request-resource", "runtime-internal"] },
        "resourceRef": { "$ref": "#/$defs/identifier" },
        "operation": { "$ref": "#/$defs/operationToken" },
        "effectMode": { "enum": ["none", "journaled"] },
        "effectKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{7,255}$"
        },
        "effectClass": {
          "enum": [
            "runtime-internal",
            "read-only",
            "reversible-change",
            "irreversible-change",
            "external-publication",
            "financial",
            "privilege-change",
            "secret-access"
          ]
        },
        "riskLevel": { "enum": ["low", "medium", "high", "critical"] },
        "requestedControls": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/control" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "scope": { "const": "request-resource" } },
            "required": ["scope"]
          },
          "then": { "required": ["resourceRef"] },
          "else": {
            "not": { "required": ["resourceRef"] },
            "properties": {
              "effectMode": { "const": "none" },
              "effectClass": { "const": "runtime-internal" }
            }
          }
        },
        {
          "if": {
            "properties": { "effectMode": { "const": "journaled" } },
            "required": ["effectMode"]
          },
          "then": { "required": ["effectKey"] },
          "else": { "not": { "required": ["effectKey"] } }
        }
      ]
    },
    "control": {
      "enum": [
        "checkpoint-before-mutation",
        "verify-after-effect",
        "reconcile-before-retry",
        "revocation-check-before-effect",
        "sanitize-output",
        "no-secret-materialization"
      ]
    },
    "riskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumRisk", "triggeredBoundaries", "requestResourceActionCount", "journaledEffectCount"],
      "properties": {
        "maximumRisk": { "enum": ["low", "medium", "high", "critical"] },
        "triggeredBoundaries": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "destructive",
              "irreversible",
              "financial",
              "privilege-expansion",
              "external-publication",
              "secret-access"
            ]
          }
        },
        "requestResourceActionCount": { "type": "integer", "minimum": 0, "maximum": 256 },
        "journaledEffectCount": { "type": "integer", "minimum": 0, "maximum": 256 }
      }
    }
  }
}
