{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:overcore:contracts:task-result:v1",
  "title": "OverCore TaskResult v1",
  "description": "Resultado verificável, bloqueio recuperável, falha ou cancelamento devolvido pelo OverCore.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "resultId",
    "requestId",
    "requestFingerprint",
    "taskId",
    "stateRef",
    "reportedAt",
    "status",
    "summary",
    "criteria",
    "evidence",
    "artifacts",
    "effects",
    "execution"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0"
    },
    "resultId": {
      "$ref": "#/$defs/identifier"
    },
    "requestId": {
      "$ref": "#/$defs/identifier"
    },
    "requestFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "const": "sha256-jcs-v1"
        },
        "value": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "taskId": {
      "$ref": "#/$defs/identifier"
    },
    "stateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateRevision", "transitionId", "emissionSequence"],
      "properties": {
        "stateRevision": {
          "type": "integer",
          "minimum": 1
        },
        "transitionId": {
          "$ref": "#/$defs/identifier"
        },
        "emissionSequence": {
          "type": "integer",
          "minimum": 1
        },
        "supersedesResultId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "reportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["succeeded", "failed", "blocked", "cancelled"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/criterionResult"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "effects": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attemptCount", "maxParallelismObserved", "durationMs", "lastTransitionAt"],
      "properties": {
        "attemptCount": {
          "type": "integer",
          "minimum": 0
        },
        "maxParallelismObserved": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastTransitionAt": {
          "type": "string",
          "format": "date-time"
        },
        "checkpointArtifactRef": {
          "$ref": "#/$defs/identifier"
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "costUsd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "inputRequired": {
      "$ref": "#/$defs/inputRequired"
    },
    "failure": {
      "$ref": "#/$defs/failure"
    },
    "cancellation": {
      "$ref": "#/$defs/cancellation"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "criteria": {
            "items": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              },
              "required": ["status"]
            }
          },
          "execution": {
            "required": ["finishedAt"]
          },
          "effects": {
            "items": {
              "properties": {
                "status": {
                  "enum": ["confirmed", "rolled-back", "not-applied"]
                }
              },
              "required": ["status"]
            }
          }
        },
        "not": {
          "anyOf": [
            { "required": ["inputRequired"] },
            { "required": ["failure"] },
            { "required": ["cancellation"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["inputRequired"],
        "properties": {
          "execution": {
            "not": {
              "required": ["finishedAt"]
            }
          }
        },
        "not": {
          "anyOf": [
            { "required": ["failure"] },
            { "required": ["cancellation"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["failure"],
        "properties": {
          "failure": {
            "properties": {
              "retryable": {
                "const": false
              }
            },
            "required": ["retryable"]
          },
          "execution": {
            "required": ["finishedAt"]
          },
          "effects": {
            "items": {
              "properties": {
                "status": {
                  "enum": ["confirmed", "rolled-back", "not-applied"]
                }
              },
              "required": ["status"]
            }
          }
        },
        "not": {
          "anyOf": [
            { "required": ["inputRequired"] },
            { "required": ["cancellation"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "cancelled"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["cancellation"],
        "properties": {
          "execution": {
            "required": ["finishedAt"]
          }
        },
        "not": {
          "anyOf": [
            { "required": ["inputRequired"] },
            { "required": ["failure"] }
          ]
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "operationToken": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z][a-z0-9]*)+$",
      "maxLength": 100
    },
    "criterionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "status", "evidenceRefs"],
      "properties": {
        "criterionId": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": ["passed", "failed", "not-run"]
        },
        "evidenceRefs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not-run"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evidenceRefs": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "evidenceRefs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["runtime", "executor", "external", "human"]
        },
        "id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "kind", "capturedAt", "summary", "digest", "artifactRefs", "origin"],
      "properties": {
        "evidenceId": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "command-output",
            "test-result",
            "inspection",
            "schema-validation",
            "external-receipt",
            "human-confirmation",
            "state-readback"
          ]
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "artifactRefs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "origin": {
          "$ref": "#/$defs/origin"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "kind", "uri", "digest", "mediaType", "sensitivity", "createdAt"],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": ["file", "report", "log", "patch", "test-report", "checkpoint", "receipt", "other"]
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2000
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "sensitivity": {
          "enum": ["public", "internal", "restricted"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effectId",
        "effectKey",
        "intentFingerprint",
        "resourceRef",
        "operation",
        "status",
        "evidenceRefs"
      ],
      "properties": {
        "effectId": {
          "$ref": "#/$defs/identifier"
        },
        "effectKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{7,255}$"
        },
        "intentFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "resourceRef": {
          "$ref": "#/$defs/identifier"
        },
        "operation": {
          "$ref": "#/$defs/operationToken"
        },
        "status": {
          "enum": ["confirmed", "rolled-back", "not-applied", "unknown"]
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "compensationEffectRef": {
          "$ref": "#/$defs/identifier"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "rolled-back"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["compensationEffectRef"]
          },
          "else": {
            "not": {
              "required": ["compensationEffectRef"]
            }
          }
        }
      ]
    },
    "inputRequired": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockId", "mode", "code", "kind", "reason", "question", "options", "impact", "evidenceRefs"],
      "properties": {
        "blockId": {
          "$ref": "#/$defs/identifier"
        },
        "mode": {
          "enum": ["resume-same-request", "replacement-request-required"],
          "description": "Define se a tarefa atual pode retomar sem alterar o TaskRequest ou exige nova admissão."
        },
        "code": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": ["information", "authority", "resource", "decision", "external-condition"]
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 2000
        },
        "question": {
          "type": "string",
          "minLength": 3,
          "maxLength": 2000
        },
        "options": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "consequence"],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "consequence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        },
        "impact": {
          "type": "string",
          "minLength": 3,
          "maxLength": 2000
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "retryable", "summary", "evidenceRefs"],
      "properties": {
        "code": {
          "$ref": "#/$defs/identifier"
        },
        "category": {
          "enum": ["transient", "permanent", "policy", "resource", "verification", "internal", "external"]
        },
        "retryable": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "minLength": 3,
          "maxLength": 2000
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "initiatedBy", "summary", "evidenceRefs"],
      "properties": {
        "code": {
          "$ref": "#/$defs/identifier"
        },
        "initiatedBy": {
          "enum": ["client", "policy", "runtime", "deadline"]
        },
        "summary": {
          "type": "string",
          "minLength": 3,
          "maxLength": 2000
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "const": "sha256-jcs-v1"
        },
        "value": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
